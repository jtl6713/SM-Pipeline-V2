# Copy to .env on the VM. Never commit the filled file.

# Cloudflare Tunnel token for the existing named tunnel f7a22f0f-...
# Create a token in Zero Trust -> Tunnels -> this tunnel -> configure.
CLOUDFLARED_TUNNEL_TOKEN=

# Public URLs stay on chicagoshining.com even when origins move.
PIPELINE_RUNNER_PUBLIC_URL=https://pipeline.chicagoshining.com
VIDEO_COMPRESSOR_PUBLIC_URL=https://compress.chicagoshining.com
FRAME_EXTRACTOR_PUBLIC_URL=https://frames.chicagoshining.com
TIMING_ENGINE_PUBLIC_URL=https://timing.chicagoshining.com

# pipeline-runner
PIPELINE_RUNNER_SHARED_SECRET=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appe33zkZn35yirTL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VARIANT_SERVICE_URL=
