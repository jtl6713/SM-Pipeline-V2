/
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Do not use immutable year-long caching for Studio assets. Filenames are
# reused across deploys; immutable + same path left operators on stale UI
# (e.g. footer stuck at 0.6.275) even in a fresh browser.
/assets/*
  Cache-Control: public, max-age=60, must-revalidate

/docs/*
  Cache-Control: public, max-age=3600
