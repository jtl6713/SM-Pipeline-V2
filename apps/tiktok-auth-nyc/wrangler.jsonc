{
  "name": "chicagoshining-tiktok-auth-nyc",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "account_id": "cbb5651c94e9bd2efc4594dc87229acb",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "auth-nyc.chicagoshining.com",
      "custom_domain": true
    }
