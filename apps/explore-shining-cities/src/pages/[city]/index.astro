---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaHero from "../../components/MediaHero.astro";
import StoryCard from "../../components/StoryCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { SITE, cities, getCityStories } from "../../data/site.mjs";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const cityStories = getCityStories(city.slug);
const featured = cityStories[0];
const title = `${city.brand} | Explore Shining Cities`;
const description = city.intro;
const citySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: city.brand,
  description,
  url: `${SITE.url}/${city.slug}`,
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url
  },
  about: {
    "@type": "City",
    name: city.name,
    addressRegion: city.state,
    addressCountry: "US"
  }
};
---
<BaseLayout title={title} description={description} image={city.hero} city={city} schema={citySchema}>
  <MediaHero
    image={city.hero}
    alt={city.heroAlt}
    eyebrow={city.eyebrow}
    title={city.brand}
    copy={city.intro}
    actionHref="#latest"
    actionLabel={`Explore ${city.name}`}
    secondaryHref="/#cities"
    secondaryLabel="Switch city"
  />

  <section class="section">
    <div class="shell city-overview">
      <div>
        <p class="eyebrow">{city.socialBrand}</p>
        <h2>{city.description}</h2>
      </div>
      <div class="city-overview__details">
        <p>Start with</p>
        <div class="pill-row">
          {city.featuredCategories.map((category) => <span class="pill">{category}</span>)}
        </div>
      </div>
    </div>
  </section>

  {featured && (
    <section class="section section--feature" id="latest">
      <div class="shell">
        <SectionHeading
          eyebrow="Featured"
          title="A place to start"
          copy="One strong visual story, then more ways into the city."
        />
        <StoryCard story={featured} city={city} featured={true} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Explore the city"
        title={`More from ${city.name}`}
        copy="Landmarks, neighborhoods and views selected from the Shining Cities media library."
      />
      <div class="story-grid">
        {cityStories.slice(1).map((story) => <StoryCard story={story} city={city} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell split-panel">
      <div>
        <p class="eyebrow">Neighborhoods & areas</p>
        <h2>Move beyond a single landmark.</h2>
        <p>Use the city as a collection of scenes, each with its own pace, architecture and point of view.</p>
      </div>
      <div class="location-list">
        {city.neighborhoods.map((name) => <span>{name}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell social-strip">
      <div>
        <p class="eyebrow">Social discovery</p>
        <h2>Keep exploring with {city.socialBrand}.</h2>
        <p>The site stands on its own; social adds the moving moments, quick hits and new discoveries between stories.</p>
      </div>
      <div class="social-links">
        {city.social.length > 0 ? (
          city.social.map((item) => <a class="button button--dark" href={item.href} rel="me noopener" target="_blank">{item.label}</a>)
        ) : (
          <a class="button button--dark" href="/about#contact">Find the brand</a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
