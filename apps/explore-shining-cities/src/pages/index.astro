---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaHero from "../components/MediaHero.astro";
import CityCard from "../components/CityCard.astro";
import StoryCard from "../components/StoryCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE, cities, publishedStories, getCity } from "../data/site.mjs";

const leadStories = publishedStories.slice(0, 6);
---
<BaseLayout title={SITE.title} description={SITE.description} image={cities[0].hero}>
  <MediaHero
    image={cities[0].hero}
    alt={cities[0].heroAlt}
    eyebrow="Chicago · Los Angeles · Miami · New York"
    title={SITE.tagline}
    copy="Explore the neighborhoods, views, landmarks, culture and everyday moments that make great cities memorable."
    actionHref="#cities"
    actionLabel="Choose a city"
    secondaryHref="#explore"
    secondaryLabel="Explore stories"
  />

  <section class="section section--intro">
    <div class="shell editorial-intro">
      <p class="eyebrow">Explore Shining Cities</p>
      <p class="editorial-intro__lead">
        City discovery through a more visual lens.
      </p>
      <p class="editorial-intro__copy">
        We follow the places people know, the corners they miss, and the changing light in between—built from original Shining Cities media and stories across each destination.
      </p>
    </div>
  </section>

  <section class="section" id="cities">
    <div class="shell">
      <SectionHeading
        eyebrow="Featured cities"
        title="Four cities. Four distinct rhythms."
        copy="Each city has its own visual identity and point of view, connected by one shared approach to discovery."
      />
      <div class="city-grid">
        {cities.map((city, index) => <CityCard city={city} priority={index < 2} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark" id="explore">
    <div class="shell">
      <SectionHeading
        eyebrow="Explore"
        title="Start with a place worth seeing."
        copy="A growing collection of landmarks, neighborhoods, architecture, waterfronts and city views."
      />
      <div class="story-grid">
        {leadStories.map((story, index) => (
          <StoryCard story={story} city={getCity(story.city)} featured={index === 0} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell category-band">
      <div>
        <p class="eyebrow">More ways to explore</p>
        <h2>Follow what catches your eye.</h2>
      </div>
      <div class="category-cloud" aria-label="Explore categories">
        {["Things to See", "Neighborhoods", "Food & Drink", "Hidden Gems", "City Views", "Waterfront", "Architecture", "Nightlife", "Parks", "Seasonal", "Quick Hits"].map((category) => (
          <span>{category}</span>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
