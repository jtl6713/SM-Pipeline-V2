---
import { storyUrl } from "../data/site.mjs";
const { story, city, featured = false } = Astro.props;
---
<article class:list={["story-card", featured && "story-card--featured"]}>
  <a class="story-card__media" href={storyUrl(story)} aria-label={`Read ${story.title}`}>
    <img
      src={story.image}
      alt={story.imageAlt}
      width={featured ? "1400" : "900"}
      height={featured ? "900" : "675"}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="story-card__body">
    <p class="eyebrow">{story.kicker}</p>
    <h3><a href={storyUrl(story)}>{story.title}</a></h3>
    <p>{story.summary}</p>
    <div class="story-card__meta">
      <span>{city?.name}</span>
      <a class="text-link" href={storyUrl(story)}>Explore<span aria-hidden="true"> →</span></a>
    </div>
  </div>
</article>
