---
const {
  image,
  alt,
  eyebrow,
  title,
  copy,
  actionHref,
  actionLabel,
  secondaryHref,
  secondaryLabel,
  compact = false
} = Astro.props;
---
<section class:list={["media-hero", compact && "media-hero--compact"]}>
  <img
    class="media-hero__image"
    src={image}
    alt={alt}
    width="1800"
    height="1200"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="media-hero__veil" aria-hidden="true"></div>
  <div class="shell media-hero__content">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    {copy && <p class="hero-copy">{copy}</p>}
    {(actionHref || secondaryHref) && (
      <div class="hero-actions">
        {actionHref && <a class="button button--light" href={actionHref}>{actionLabel}</a>}
        {secondaryHref && <a class="text-link text-link--light" href={secondaryHref}>{secondaryLabel}<span aria-hidden="true"> →</span></a>}
      </div>
    )}
  </div>
</section>
