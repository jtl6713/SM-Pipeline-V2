---
const { city, priority = false } = Astro.props;
---
<article class="city-card" style={`--card-accent: ${city.accent};`}>
  <a class="city-card__media" href={`/${city.slug}`} aria-label={`Explore ${city.name}`}>
    <img
      src={city.hero}
      alt={city.heroAlt}
      width="1200"
      height="900"
      loading={priority ? "eager" : "lazy"}
      decoding="async"
    />
  </a>
  <div class="city-card__body">
    <p class="eyebrow">{city.socialBrand}</p>
    <h3><a href={`/${city.slug}`}>{city.name}</a></h3>
    <p>{city.description}</p>
    <a class="text-link" href={`/${city.slug}`}>Explore {city.name}<span aria-hidden="true"> →</span></a>
  </div>
</article>
