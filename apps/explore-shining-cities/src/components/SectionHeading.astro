---
const { eyebrow, title, copy, href, linkLabel } = Astro.props;
---
<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  <div class="section-heading__aside">
    {copy && <p>{copy}</p>}
    {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true"> →</span></a>}
  </div>
</div>
