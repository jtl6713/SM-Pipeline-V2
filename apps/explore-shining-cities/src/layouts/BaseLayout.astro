---
import "../styles/global.css";
import { SITE, cities } from "../data/site.mjs";

const {
  title = SITE.title,
  description = SITE.description,
  image,
  city,
  schema
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const shareImage = image ? new URL(image, SITE.url).toString() : undefined;
const analyticsToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const structuredData =
  schema ??
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description
  };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a0d10" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        ></script>
      )
    }
  </head>
  <body style={city?.accent ? `--city-accent: ${city.accent}; --city-accent-soft: ${city.accentSoft};` : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="wordmark" href="/" aria-label="Explore Shining Cities home">
          <span class="wordmark-mark" aria-hidden="true">✦</span>
          <span>Explore Shining Cities</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/#cities">Explore Cities</a>
          {cities.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}
          <a href="/#explore">Stories</a>
          <a href="/about">About</a>
        </nav>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/#cities">Explore Cities</a>
            {cities.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}
            <a href="/#explore">Stories</a>
            <a href="/about">About</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="wordmark footer-wordmark" href="/">
            <span class="wordmark-mark" aria-hidden="true">✦</span>
            <span>Explore Shining Cities</span>
          </a>
          <p class="footer-copy">
            Discover the places, experiences, neighborhoods, landmarks, culture and moments that make each city shine.
          </p>
        </div>
        <div>
          <p class="footer-label">Cities</p>
          <div class="footer-links">
            {cities.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}
          </div>
        </div>
        <div>
          <p class="footer-label">Explore</p>
          <div class="footer-links">
            <a href="/#explore">Stories</a>
            <a href="/about">About</a>
            <a href="/about#contact">Contact</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Explore Shining Cities</span>
        <span>Chicago · Los Angeles · Miami · New York</span>
      </div>
    </footer>
  </body>
</html>
