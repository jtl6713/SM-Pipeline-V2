  "R2B - Retry Asset Selection": {
    "op": "and",
    "args": [
      {
        "op": "=",
        "field": "Do_Not_Publish",
        "type": "checkbox",
        "value": false
      },
      {
        "op": "isNotEmpty",
        "field": "Content_Item",
        "type": "multipleRecordLinks"
      },
      {
        "op": "isAnyOf",
        "field": "Output_Status",
        "type": "singleSelect",
        "value": [
          "Ready for Review"
        ]
      },
      {
        "op": "isAnyOf",
        "field": "Asset_Selection_Status",
        "type": "singleSelect",
        "value": [
          "Partial Match",
          "Selection Error"
        ]
      },
      {
        "op": "isAnyOf",
        "field": "Asset_Need_Status",
        "type": "singleSelect",
        "value": [
          "Sent to Team",
          "Partially Fulfilled",
          "Fulfilled"
        ]
      },
      {
        "op": "or",
        "args": [
          {
            "op": "isEmpty",
            "field": "Asset_Selection_Attempt_Count",
            "type": "number"
          },
          {
            "op": "<",
            "field": "Asset_Selection_Attempt_Count",
            "type": "number",
            "value": 5
          }
        ]
      },
      {
        "op": "or",
        "args": [
          {
            "op": "isEmpty",
            "field": "Asset_Selection_Next_Retry_At",
            "type": "dateTime"
          },
          {
            "op": "<=",
            "field": "Asset_Selection_Next_Retry_At",
            "type": "dateTime",
            "value": {
              "mode": "today",
              "timeZone": "America/Chicago"
            }
          }
        ]
      },
      {
        "op": "isEmpty",
        "field": "Render_Status",
        "type": "singleSelect"
      },
      {
        "op": "isEmpty",
        "field": "Render_Clip_List_JSON",
        "type": "multilineText"
      },
      {
        "op": "isEmpty",
        "field": "Remotion_Props_JSON",
        "type": "multilineText"
      },
      {
        "op": "isEmpty",
        "field": "Output_URL",
        "type": "url"
      },
      {
        "op": "isEmpty",
        "field": "Final_File_URL",
        "type": "url"
      },
      {
        "op": "isEmpty",
        "field": "Final_File_ID",
        "type": "singleLineText"
      },
      {
        "op": "isAnyOf",
        "field": "Format",
        "type": "singleSelect",
        "value": [
          "Vertical Short Video",
          "Story"
        ]
      }
    ]
  },
