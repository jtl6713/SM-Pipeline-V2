# Local bind
PORT=3350
HOST=127.0.0.1
LOG_LEVEL=info

# Public route (Cloudflare Tunnel)
PUBLIC_BASE_URL=https://pipeline.chicagoshining.com

# Shared secret — Worker must send X-Pipeline-Secret on stage POSTs
PIPELINE_RUNNER_SHARED_SECRET=

# Airtable
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appe33zkZn35yirTL

# Downstream local services (defaults match production layout)
REMOTION_RENDERER_URL=http://127.0.0.1:3333
VOICEOVER_NORMALIZER_URL=http://127.0.0.1:3012
YOUTUBE_UPLOADER_URL=http://127.0.0.1:3340
# Google Drive (reuse YouTube OAuth app with Drive scope, or a dedicated refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional overrides — otherwise loaded from Airtable Pipeline Settings
VARIANT_SERVICE_URL=
VARIANT_SERVICE_TOKEN=
R2_UPLOAD_WORKER_URL=
R2_UPLOAD_WORKER_SECRET=
STUDIO_PREVIEW_R2_PREFIX=studio/previews

# External APIs (migrate from Make connections as stages are implemented)
OPENAI_API_KEY=
OPENAI_R2_MODEL=gpt-4.1
ELEVENLABS_API_KEY=
# P4 missing-asset webhook (R2 modules 20/21 — defaults to Make hook URL)
P4_WEBHOOK_URL=

# P3 handoff webhook (P2 success path — used only while STAGE_BACKEND_P3=make)
P3_WEBHOOK_URL=
# python = P2 calls local /stages/p3 instead of the Make webhook
STAGE_BACKEND_P3=make

# RR1 review email (Gmail API — refresh token needs https://www.googleapis.com/auth/gmail.send)
RR1_REVIEW_EMAIL_TO=chicagoshining@gmail.com
# Future RR1 email buttons call Python RR2. Set RR2_WEBHOOK_TOKEN in runtime .env.
RR1_DECISION_WEBHOOK_URL=https://pipeline.chicagoshining.com/hooks/rr2/<RR2_WEBHOOK_TOKEN>
RR2_WEBHOOK_TOKEN=

# Carousel review buttons (C3B). SAI1 and C2–C9 are Python.
C3B_WEBHOOK_TOKEN=
C3_EMAIL_TO=chicagoshining@gmail.com
WATERMARK_SERVICE_URL=https://watermark.chicagoshining.com
OPENAI_SAI1_MODEL=gpt-5
