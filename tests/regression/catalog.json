    "mx1-single-native": {
      "kind": "studio-scenario",
      "title": "Millennium Park — single still native test",
      "summary": "One Chicago still. Silent native singles. AI thumbnail required for the grid.",
      "origin": "ez-wizard",
      "ez_input": "single-photo",
      "package": "slides",
      "content_type": "Feed Post",
      "photo_count": 1,
      "voiceover_mode": "No",
      "background_music_mode": "No",
      "thumbnail_mode": "Yes",
      "caption_mode": "ai",
      "platforms": ["Instagram", "Facebook"],
      "overrides": { "Instagram": "Single Image", "Facebook": "Single Image" },
      "extras": [],
      "expected_route": "uploaded:native_still",
      "photos": ["cloud-gate"],
      "publish": {
        "instagram": "container-only",
        "facebook": "unpublished-only",
        "youtube": "skip",
        "tiktok": "skip"
      }
    },
